  "cards": [
    {
      "dot": "emerald",
      "title": "The hot path skips IAM",
      "items": [
        "Each request: Main verifies the pass signature itself",
        "Revocation: check the blocklist in the shared Redis",
        "If IAM dies, shopping still works; only new logins fail"
      ]
    },
    {
      "dot": "violet",
      "title": "gRPC between Main and IAM",
      "items": [
        "Login, pass refresh, logout",
        "Fetch many users at once (GetUsersByIds) instead of JOIN",
        "Change role when approving a seller (SetUserRole, not atomic yet)"
      ]
    },
    {
      "dot": "rose",
      "title": "The price",
      "items": [
        "The DB no longer checks that the user exists (soft FK)",
        "No more JOIN; batch calls to avoid N+1",
        "A dedicated gateway is left for a later phase"
      ]
    }
