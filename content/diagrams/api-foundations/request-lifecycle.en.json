    },
    {
      "id": "g1",
      "from": "guard",
      "to": "pipe",
      "y": 280,
      "label": "valid pass, enough permissions",
      "variant": "security"
    },
    {
      "id": "p1",
      "from": "pipe",
      "to": "ctrl",
      "y": 315,
      "label": "body matches the form"
    },
    {
      "id": "c1",
      "from": "ctrl",
      "to": "icpt",
      "y": 350,
      "label": "result: order id, total"
    },
    {
      "id": "ok",
      "from": "icpt",
      "to": "browser",
      "y": 385,
      "label": "201 { success, data, msg }",
      "variant": "return"
    },
    {
      "id": "req2",
      "from": "browser",
      "to": "mw",
      "y": 460,
      "label": "POST /checkout",
      "variant": "emphasis"
    },
    {
      "id": "mw2",
      "from": "mw",
      "to": "guard",
      "y": 495,
      "label": "forward"
    },
    {
      "id": "g2",
      "from": "guard",
      "to": "pipe",
      "y": 530,
      "label": "past security",
      "variant": "security"
    },
    {
      "id": "p2",
      "from": "pipe",
      "to": "ctrl",
      "y": 565,
      "label": "body matches the form"
    },
    {
      "id": "c2",
      "from": "ctrl",
      "to": "filter",
      "y": 600,
      "label": "throws 409: out of stock",
      "variant": "dashed",
      "note": "Stock reservation failed; the error carries code FLASH_SALE_OUT_OF_STOCK"
    },
    {
      "id": "err",
      "from": "filter",
      "to": "browser",
      "y": 660,
      "label": "409 { success: false, msg }",
      "variant": "return",
      "note": "Code lost: the frontend only shows axios's default message"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Fixed order",
      "items": [
        "Host → security → body check → handling → packaging",
        "Security blocks before any effort goes into checking the body",
        "An error at any stop goes to the error-reporting stop"
      ]
    },
    {
      "dot": "rose",
      "title": "Bug found",
      "items": [
        "The exception carries code FLASH_SALE_OUT_OF_STOCK",
        "The error stop keeps only message, returns a msg field",
        "The frontend reads message and code, so it finds nothing"
      ]
    }
  ]
}