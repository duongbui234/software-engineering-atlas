    {
      "id": "lost",
      "from": "api",
      "to": "client",
      "y": 360,
      "label": "201 Created",
      "variant": "dashed",
      "note": "Network drops: the client never gets the response"
    },
    {
      "id": "req-2",
      "from": "client",
      "to": "api",
