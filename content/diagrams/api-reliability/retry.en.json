  "cards": [
    {
      "dot": "emerald",
      "title": "Key ideas",
      "items": [
        "The client generates a unique key per payment intent",
        "The server records the key before any side effect",
        "A retry with the same key only gets the old result back"
      ]
    },
    {
      "dot": "rose",
      "title": "Common traps",
      "items": [
        "Retry while the key is processing: return 409, don't run in parallel",
        "Same key, different body: must reject with 422",
        "Too short a TTL: a late retry still charges twice"
      ]
    }
  ]
