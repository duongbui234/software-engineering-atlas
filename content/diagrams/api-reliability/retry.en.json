    },
    {
      "id": "lock",
      "from": "api",
      "to": "store",
      "y": 195,
      "label": "reserve key k1: processing",
      "variant": "default",
      "note": "SET k1 processing NX: write only if absent"
    },
    {
      "id": "lock-ok",
      "from": "store",
      "to": "api",
      "y": 240,
