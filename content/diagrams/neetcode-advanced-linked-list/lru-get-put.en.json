    },
    {
      "id": "m12",
      "from": "map",
      "to": "caller",
      "y": 895,
      "label": "return −1: key 2 was evicted",
      "variant": "return",
      "note": "every operation O(1)"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Invariants",
      "items": [
        "Each key in the hash map points to exactly one node in the list",
        "Right after head is the most recently used key",
        "Right before tail is the least recently used key"
      ]
    },
    {
      "dot": "amber",
      "title": "Cost",
      "items": [
        "get, put: O(1) time",
        "Unlink: 2 pointer writes; link at the front: 4",
        "O(capacity) memory: one node and one map slot per key"
      ]
    },
    {
      "dot": "rose",
      "title": "Common traps",
      "items": [
        "get does not move the node: the wrong key is evicted",
        "Unlinking without deleting from the map: the map keeps growing",
        "Updating an existing key without moving it"
      ]
    }
  ]
}