    },
    {
      "id": "m1",
      "from": "map",
      "to": "list",
      "y": 235,
      "label": "create node 1, link it right after head",
      "variant": "default",
      "note": "pushFront: head ⇄ 1 ⇄ tail"
    },
    {
      "id": "m2",
      "from": "caller",
      "to": "map",
      "y": 295,
      "label": "put(2, 2): not full, keep adding",
