      "note": "map.size = 1 < 2"
    },
    {
      "id": "m3",
      "from": "map",
      "to": "list",
      "y": 355,
      "label": "node 2 goes first, node 1 moves back",
      "variant": "default",
      "note": "head ⇄ 2 ⇄ 1 ⇄ tail"
    },
    {
      "id": "m4",
      "from": "caller",
      "to": "map",
      "y": 415,
      "label": "step 2: get(1)",
      "variant": "default",
      "note": "map.get(1) → node 1, O(1)"
    },
    {
      "id": "m5",
      "from": "map",
      "to": "list",
      "y": 475,
      "label": "unlink node 1, relink it after head",
      "variant": "default",
      "note": "unlink + pushFront: head ⇄ 1 ⇄ 2 ⇄ tail"
    },
    {
      "id": "m6",
      "from": "list",
      "to": "caller",
      "y": 535,
      "label": "return 1: node 1 is now the newest",
      "variant": "return",
      "note": "the value lives in the node"
    },
    {
      "id": "m7",
      "from": "caller",
      "to": "map",
      "y": 595,
      "label": "step 3: put(3, 3), cache is full",
      "variant": "default",
      "note": "map.size = 2 = capacity"
    },
    {
      "id": "m8",
      "from": "map",
      "to": "list",
      "y": 655,
      "label": "ask for the oldest: the node before tail",
      "variant": "default",
      "note": "old = tail.prev → node 2"
    },
    {
      "id": "m9",
      "from": "list",
      "to": "map",
      "y": 715,
      "label": "unlink node 2, hand back key 2 to delete",
      "variant": "default",
      "note": "unlink(old); map.delete(old.key)"
    },
    {
      "id": "m10",
      "from": "map",
      "to": "list",
      "y": 775,
      "label": "create node 3, link it after head",
      "variant": "default",
      "note": "head ⇄ 3 ⇄ 1 ⇄ tail"
    },
    {
      "id": "m11",
      "from": "caller",
      "to": "map",
      "y": 835,
      "label": "step 4: get(2)",
      "variant": "default",
