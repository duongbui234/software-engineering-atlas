  "cards": [
    {
      "dot": "cyan",
      "title": "The range invariant",
      "items": [
        "If present, target is in [lo, hi]",
        "Every pass keeps this true",
        "An empty range proves absence"
      ]
    },
    {
      "dot": "amber",
      "title": "Each pass drops half",
      "items": [
        "8 → 4 → 2 → 1 cells",
        "At most ⌊log₂ n⌋ + 1 looks",
        "10⁶ elements: 20 looks"
      ]
    },
    {
      "dot": "rose",
      "title": "Common traps",
      "items": [
        "lo = mid can loop forever",
        "[lo, hi] goes with lo <= hi",
        "(lo + hi) / 2 overflows 32-bit int"
