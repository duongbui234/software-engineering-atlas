  "cards": [
    {
      "dot": "cyan",
      "title": "Why a min-heap",
      "items": [
        "The heap keeps the k largest seen so far",
        "Its top is the weakest of those k",
        "That is exactly the k-th largest"
      ]
    },
    {
      "dot": "amber",
      "title": "Cost",
      "items": [
        "Smaller than the top: drop, O(1)",
        "Larger: replace the top, sift O(log k)",
        "Independent of the stream length"
      ]
    },
    {
      "dot": "rose",
      "title": "Common traps",
      "items": [
        "A max-heap keeps the k smallest",
        "No trim past k: top is the stream minimum",
        "Python heapq is min-heap only"
      ]
    }
  ]
