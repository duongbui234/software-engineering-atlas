  "cards": [
    {
      "dot": "cyan",
      "title": "Two invariants",
      "items": [
        "Lower has as many as upper, or one more",
        "Every lower number ≤ every upper number",
        "The median sits at one or two tops"
      ]
    },
    {
      "dot": "amber",
      "title": "Cost",
      "items": [
        "addNum: at most three pushes/pops, O(log n)",
        "findMedian: read two tops, O(1)",
        "Sorted array: insert is O(n) because it shifts"
      ]
    },
    {
      "dot": "rose",
      "title": "Common traps",
      "items": [
        "Alternating without crossing heaps: order breaks",
        "No rebalancing: the median drifts",
        "Integer (a + b) / 2: loses the .5"
      ]
    }
  ]
