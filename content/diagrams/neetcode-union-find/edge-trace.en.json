{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Two roads in the same group",
    "quality_profile": "showcase",
    "output": "content/diagrams/neetcode-union-find/edge-trace.en.html",
    "legend": {
      "entries": {
        "default": {
          "label": "New edge"
        },
        "return": {
          "label": "Registry result"
        }
      }
    }
  },
  "participants": [
    {
      "id": "reader",
      "type": "backend",
      "label": "Edge reader",
      "sublabel": "redundantByDsu"
    },
    {
      "id": "registry",
      "type": "database",
      "label": "Group registry",
      "sublabel": "DisjointSet"
    }
  ],
  "messages": [
    {
      "id": "edge-trace-1",
      "from": "reader",
      "to": "registry",
      "y": 165,
      "label": "Send the first edge",
      "note": "union(1, 4)",
      "variant": "default"
    },
    {
      "id": "edge-trace-2",
      "from": "registry",
      "to": "reader",
      "y": 240,
      "label": "Merge two singleton groups",
      "note": "root(1) = root(4) = 1",
      "variant": "return"
    },
    {
      "id": "edge-trace-3",
      "from": "reader",
      "to": "registry",
      "y": 315,
      "label": "Send the second edge",
      "note": "union(2, 4)",
      "variant": "default"
    },
    {
      "id": "edge-trace-4",
      "from": "registry",
      "to": "reader",
      "y": 390,
      "label": "Attach the smaller group",
      "note": "parent[2] = 1, size[1] = 3",
      "variant": "return"
    },
    {
      "id": "edge-trace-5",
      "from": "reader",
      "to": "registry",
      "y": 465,
      "label": "Try a road from 1 to 2",
      "note": "union(1, 2)",
      "variant": "default"
    },
    {
      "id": "edge-trace-6",
      "from": "registry",
      "to": "reader",
      "y": 540,
      "label": "Same root, so the edge closes a cycle",
      "note": "root(1) = root(2) = 1 → false",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "The third edge closes the cycle",
      "items": [
        "Later edges may attach new vertices. The first edge to close a cycle is already the answer because the input has exactly one cycle."
      ]
    }
  ]
}
