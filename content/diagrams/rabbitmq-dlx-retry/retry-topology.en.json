    {
      "dot": "emerald",
      "title": "The retry loop",
      "items": [
        "On error, nack without requeue: the letter goes to the waiting slot",
        "Nobody reads the waiting slot; the letter sits 5 seconds, then expires",
        "On expiry, it is dead-lettered back to the main sorting desk"
      ]
    },
    {
      "dot": "violet",
      "title": "Counting attempts",
      "items": [
        "The x-death header records each time the letter is dead-lettered",
        "count for the work slot with reason rejected = number of failures",
        "After 3 attempts, move it to the parking lot, then ack"
      ]
    },
    {
      "dot": "rose",
      "title": "Traps",
      "items": [
        "A DLX with no bound queue: dead letters vanish silently",
        "Waiting 5s, 30s and 5 minutes needs three waiting slots"
      ]
