    },
    {
      "id": "d2",
      "from": "pg",
      "to": "y",
      "y": 425,
      "label": "Y gets A, COMMIT",
      "variant": "return",
      "note": "deadlock_timeout = 1s"
    },
    {
      "id": "s1",
      "from": "x",
      "to": "pg",
      "y": 515,
      "label": "sorted: A first",
      "variant": "emphasis",
      "note": "sort(skuIds)"
    },
    {
      "id": "s2",
      "from": "y",
      "to": "pg",
      "y": 565,
      "label": "sorted: also A first",
      "variant": "default",
      "note": "waits for X at the very first lock"
    },
    {
      "id": "s3",
      "from": "x",
      "to": "pg",
      "y": 615,
      "label": "take B, COMMIT",
      "variant": "return"
    },
    {
      "id": "s4",
      "from": "pg",
      "to": "y",
      "y": 665,
      "label": "Y's turn, nobody aborted",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Deadlock",
      "items": [
        "Each side holds what the other needs",
        "Postgres checks after deadlock_timeout",
        "Aborts one side, unpredictably"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lock ordering",
      "items": [
        "All code locks rows in the same order",
        "flash-sale sorts skuId ascending",
        "20/20 carts done, 0 errors"
      ]
    },
    {
      "dot": "amber",
      "title": "Hold locks briefly",
      "items": [
        "No external API calls in a transaction",
        "lock_timeout to fail fast",
        "Retry 40P01 with jitter, but only as a net"
      ]
    }
  ]
