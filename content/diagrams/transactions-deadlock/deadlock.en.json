  ],
  "segments": [
    {
      "from": 150,
      "to": 470,
      "label": "Unsorted: wait cycle"
    },
    {
      "from": 495,
      "to": 700,
      "label": "Sorted ascending: queuing"
    }
  ],
  "messages": [
    {
      "id": "x1",
      "from": "x",
      "to": "pg",
      "y": 170,
      "label": "reserve SKU A",
