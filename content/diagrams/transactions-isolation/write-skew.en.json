  "cards": [
    {
      "dot": "amber",
      "title": "Snapshot Isolation",
      "items": [
        "Postgres calls it Repeatable Read",
        "Stops lost updates on the same row",
        "Doesn't stop write skew"
      ]
    },
    {
      "dot": "emerald",
      "title": "Serializable (SSI)",
      "items": [
        "Tracks who read and wrote what",
        "Doesn't block; aborts one side",
        "The app must retry 40001"
      ]
    },
    {
      "dot": "cyan",
      "title": "Read Committed",
      "items": [
        "Default in Postgres and Prisma",
        "A new snapshot per statement",
        "Even allows lost updates"
      ]
    }
