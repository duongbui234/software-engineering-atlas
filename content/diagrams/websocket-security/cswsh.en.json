  "cards": [
    {
      "dot": "rose",
      "title": "Why it happens",
      "items": ["WebSocket isn't subject to the Same-Origin Policy", "The cors option only covers HTTP polling requests", "Cookies go along if SameSite allows it"]
    },
    {
      "dot": "emerald",
      "title": "How to block it",
      "items": ["Check Origin at the handshake", "A token in auth instead of cookies", "SameSite=Lax or Strict cookies as an extra layer"]
