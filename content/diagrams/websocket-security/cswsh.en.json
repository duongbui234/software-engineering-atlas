    { "id": "e4", "from": "br", "to": "evil", "y": 335, "label": "the foreign page reads and sends as you", "variant": "security", "note": "orders, notifications, buy commands" },
    { "id": "f1", "from": "br", "to": "srv", "y": 420, "label": "handshake from the foreign page", "variant": "default", "note": "Origin: evil.example" },
